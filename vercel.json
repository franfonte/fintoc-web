{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30 }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/config",    "dest": "/api/config.py" },
    { "src": "/api/connect",   "dest": "/api/connect.py" },
    { "src": "/api/sync",      "dest": "/api/sync.py" },
    { "src": "/api/movements", "dest": "/api/movements.py" },
    { "src": "/",              "dest": "/public/index.html" },
    { "src": "/(.*)",          "dest": "/public/$1" }
  ]
}