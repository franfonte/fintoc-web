FINTOC_SECRET_KEY=leru
FINTOC_PUBLIC_KEY=leru

# ─── Supabase ─────────────────────────────────────────────────
# Get these from https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=leru

# ─── Notes ────────────────────────────────────────────────────
# NEVER commit the real .env file to GitHub.
# In Vercel: set these in Project Settings → Environment Variables.
# The SERVICE_ROLE_KEY is only used server-side and is never sent to the browser.
